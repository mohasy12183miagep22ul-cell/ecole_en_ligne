# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ecole_en_ligne
DB_PASSWORD=
DB_DATABASE=ecole_en_ligne
# DB_SSL=true
# PROXY_DE_CONFIANCE=true

# Courriel : `journal` = aucun envoi, message écrit dans les logs (développement)
MAIL_MAILER=journal
# Production sans envoi réel uniquement : code de second facteur affiché à l'écran
# AFFICHER_CODE_VERIFICATION=true
MAIL_FROM_NAME=École en ligne
MAIL_FROM_ADDRESS=ne-pas-repondre@flamboyants.edu.gn
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
DRIVE_DISK=fs
# DRIVE_DOSSIER=/tmp/stockage

# File d'attente : `database` (PostgreSQL) ; `sync` exécute immédiatement (tests)
QUEUE_DRIVER=database

# Conversion HTML → PDF : chemin d'un Chromium (ex. /usr/bin/chromium) ;
# vide = Google Chrome installé sur la machine
# PDF_NAVIGATEUR=
