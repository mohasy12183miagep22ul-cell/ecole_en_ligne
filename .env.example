# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ecole_en_ligne
DB_PASSWORD=
DB_DATABASE=ecole_en_ligne

# Courriel : `journal` = aucun envoi, message écrit dans les logs (développement)
MAIL_MAILER=journal
MAIL_FROM_NAME=École en ligne
MAIL_FROM_ADDRESS=ne-pas-repondre@flamboyants.edu.gn
SMTP_HOST=localhost
SMTP_PORT=1025
