<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiche d’inscription · {{ eleve.matricule }}</title>
  @include('pdf/_style')
  <style>
    body { padding: 24px; max-width: 820px; margin: 0 auto; }
    h2 { font-size: 12pt; margin: 18px 0 6px; color: #3B3747; }
    .grille { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; font-size: 10pt; }
    .grille div span { color: #5E5A6B; }
    .imprimer { margin: 0 0 16px; padding: 10px 16px; border-radius: 10px; border: none; background: #7424E0; color: #fff; font-weight: 700; cursor: pointer; }
    .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; font-size: 10pt; }
    .signatures div { border-top: 1px solid #DDD9E6; padding-top: 6px; height: 70px; }
    @media print { .imprimer { display: none; } body { padding: 0; } }
  </style>
</head>
<body>
  <button class="imprimer" onclick="window.print()">Imprimer la fiche</button>
  @include('pdf/_entete')
  <h1>Fiche d’inscription · {{ annee }}</h1>

  <h2>Élève</h2>
  <div class="grille">
    <div><span>Matricule :</span> <strong>{{ eleve.matricule }}</strong></div>
    <div><span>État du dossier :</span> {{ etat }}</div>
    <div><span>Nom :</span> {{ eleve.nom }}</div>
    <div><span>Prénoms :</span> {{ eleve.prenoms }}</div>
    <div><span>Sexe :</span> {{ eleve.sexe === 'F' ? 'Féminin' : 'Masculin' }}</div>
    <div><span>Né(e) le :</span> {{ naissance }} à {{ eleve.lieuNaissance }}</div>
    <div><span>Nationalité :</span> {{ eleve.nationalite || '—' }}</div>
    <div><span>N° d’acte de naissance :</span> {{ eleve.numeroActe || '—' }}</div>
  </div>

  <h2>Tuteurs</h2>
  <table>
    <thead><tr><th>Nom</th><th>Lien</th><th>Téléphone</th><th>Profession</th><th>Adresse</th></tr></thead>
    <tbody>
      @each(t in tuteurs)
        <tr>
          <td>{{ t.nom }}@if(t.principal) (principal)@end</td>
          <td>{{ t.lien }}</td>
          <td>{{ t.telephone }}</td>
          <td>{{ t.profession || '—' }}</td>
          <td>{{ t.adresse || '—' }}</td>
        </tr>
      @end
    </tbody>
  </table>

  <h2>Scolarité demandée</h2>
  <div class="grille">
    <div><span>Année :</span> {{ annee }}</div>
    <div><span>Niveau :</span> {{ niveau }}</div>
    <div><span>Classe :</span> {{ classe || 'à affecter' }}</div>
    <div><span>Redoublant :</span> {{ redoublant ? 'Oui' : 'Non' }}</div>
    <div><span>Établissement d’origine :</span> {{ origine || '—' }}</div>
    <div><span>Date du dossier :</span> {{ dateDossier }}</div>
  </div>

  <h2>Pièces du dossier</h2>
  <table>
    <thead><tr><th>Pièce</th><th>État</th></tr></thead>
    <tbody>
      @each(p in pieces)
        <tr><td>{{ p.libelle }}</td><td>{{ p.etat }}</td></tr>
      @end
    </tbody>
  </table>

  <div class="signatures">
    <div>Signature du tuteur</div>
    <div>Cachet et signature de l’établissement</div>
  </div>
</body>
</html>
