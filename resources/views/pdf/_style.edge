<style>
  * { box-sizing: border-box; }
  body { font-family: Arial, Helvetica, sans-serif; color: #1B1726; font-size: 11pt; margin: 0; }
  .entete { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #7424E0; padding-bottom: 8px; margin-bottom: 18px; }
  .entete .nom { font-size: 14pt; font-weight: 700; }
  .entete .coord { font-size: 9pt; color: #5E5A6B; line-height: 1.4; }
  h1 { font-size: 16pt; margin: 8px 0 14px; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; }
  th { background: #F1F0F5; text-align: left; padding: 6px; border-bottom: 1px solid #DDD9E6; }
  td { padding: 5px 6px; border-bottom: 1px solid #ECEAF2; }
  .pied { margin-top: 10px; font-size: 8pt; color: #77738A; }
  .saut { page-break-after: always; }
</style>
