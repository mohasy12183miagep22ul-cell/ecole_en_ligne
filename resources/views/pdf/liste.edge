<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>{{ titre }}</title>
  @include('pdf/_style')
</head>
<body>
  @include('pdf/_entete')
  <h1>{{ titre }}</h1>
  <table>
    <thead>
      <tr>
        <th>N°</th>
        @each(c in colonnes)
          <th>{{ c }}</th>
        @end
      </tr>
    </thead>
    <tbody>
      @each((ligne, index) in lignes)
        <tr>
          <td>{{ index + 1 }}</td>
          @each(v in ligne)
            <td>{{ v }}</td>
          @end
        </tr>
      @end
    </tbody>
  </table>
  <div class="pied">{{ lignes.length }} ligne{{ lignes.length > 1 ? 's' : '' }} · document édité par École en ligne</div>
</body>
</html>
